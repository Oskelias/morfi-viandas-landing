# ─────────────────────────────────────────────────────────────
# Credenciales de OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
# Tipo de credencial requerida: "OAuth client ID" de tipo "Desktop app"
# ─────────────────────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=xxxxxxxxxx

# Refresh token de larga duración obtenido una única vez.
# Se genera ejecutando: npm run auth
# (abre el navegador, el usuario autoriza el acceso y el script imprime el valor a copiar aquí)
GOOGLE_ADS_REFRESH_TOKEN=xxxxxxxxxx

# Developer token de la cuenta de Google Ads API Center
# https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxx

# ID de la cuenta MCC (Manager Account) que actúa "en nombre de" la cuenta cliente.
# Solo obligatorio si accedés a la cuenta cliente a través de una cuenta administradora.
# Formato: solo dígitos, sin guiones (ej: 1234567890)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Versión de la API de Google Ads a utilizar (opcional)
GOOGLE_ADS_API_VERSION=v17

# ─────────────────────────────────────────────────────────────
# Solo usadas por "npm run auth" para generar el refresh token
# ─────────────────────────────────────────────────────────────
# Debe coincidir EXACTAMENTE con un "Authorized redirect URI" configurado
# en el OAuth client de Google Cloud Console
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2callback
GOOGLE_ADS_OAUTH_PORT=8080
