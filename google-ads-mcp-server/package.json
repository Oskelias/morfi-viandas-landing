{
  "name": "google-ads-mcp-server",
  "version": "1.0.0",
  "description": "Servidor MCP (Model Context Protocol) para gestionar campañas de Google Ads mediante lenguaje natural",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "google-ads-mcp-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
